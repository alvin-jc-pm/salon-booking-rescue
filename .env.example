# Copy this file to .env for local use and fill in real values.
# .env is in .gitignore. Never commit real values.
# On a host, set these as environment variables or secrets instead.

# PostgreSQL connection. Hosts usually give you this URL.
DATABASE_URL=postgresql://salon:salon@localhost:5432/salon

# Key staff send in the X-Admin-Key header. At least 24 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=replace-with-a-long-random-string

# Where to listen. Most hosts set PORT for you.
HOST=0.0.0.0
PORT=8000
